# Normalisation des fins de ligne.
#
# Par défaut Git décide seul, ce qui donne CRLF sur un poste Windows.
* text=auto

# CRITIQUE : les scripts shell DOIVENT rester en LF.
# Un install.sh en CRLF fait lire `#!/usr/bin/env bash\r` au noyau Linux,
# qui cherche un interpréteur nommé « bash\r » et répond :
#   bash: ./install.sh: /usr/bin/env^M: bad interpreter: No such file or directory
*.sh        text eol=lf
*.bash      text eol=lf

# Mêmes contraintes côté serveur : nginx et systemd tolèrent CRLF, mais
# autant garder les gabarits cohérents avec ce qu'ils génèrent.
*.template  text eol=lf
*.service   text eol=lf
*.conf      text eol=lf

# Les scripts PowerShell tournent sous Windows : CRLF y est la norme.
*.ps1       text eol=crlf

# Binaires : jamais convertis, jamais diffés comme du texte.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.ico       binary
*.woff      binary
*.woff2     binary
*.jar       binary

# Fichiers générés : masqués dans les diffs de pull request pour ne pas
# noyer la revue. Ils restent versionnés et déployés.
mods/mods.json      linguist-generated=true
mods/meta/*.json    linguist-generated=true
pnpm-lock.yaml      linguist-generated=true
